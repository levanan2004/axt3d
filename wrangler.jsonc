{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axt3d-staging",
  "main": "workers/app.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS" },
  "observability": { "enabled": true },
  "d1_databases": [{ "binding": "DB", "database_name": "axt3d-staging", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "axt3d-staging-images" }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "APP_ENV": "local", "SITE_URL": "http://localhost:5173", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" }
}
