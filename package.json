{
  "name": "axt3d",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "node scripts/seed.mjs",
    "setup": "npm run db:migrate && npm run db:seed",
    "chat:reindex": "node scripts/chat-reindex.mjs",
    "preview": "wrangler dev --config build/server/wrangler.json --port 4173 --persist-to .wrangler/state",
    "deploy:staging": "node scripts/deploy-staging.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-router/node": "8.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "8.5.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261024.1",
    "@react-router/dev": "8.5.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "miniflare": "4.20260730.0",
    "prettier": "^3.8.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "undici": "7.30.1",
    "sharp": "$sharp"
  }
}
